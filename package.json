{
  "name": "doomsgame-backend",
  "version": "1.0.0",
  "description": "Backend for doomsgame.com",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "lint": "eslint . --ext .ts,.js",
    "test": "jest --runInBand",
    "audit": "npm audit --audit-level=moderate",
    "healthcheck": "node -e \"const axios=require('axios'); const url=process.env.SITE_URL||'http://localhost:3000'; axios.get(url+'/health').then(r=>console.log(JSON.stringify(r.data,null,2))).catch(e=>{ console.error(e.message); process.exit(1); });\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.37.5",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "session-file-store": "^1.5.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.6",
    "@types/node": "^20.14.2",
    "@types/cors": "^2.8.19",
    "@types/bcrypt": "^5.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/sqlite3": "^3.1.8",
    "@types/compression": "^1.7.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "supertest": "^7.2.2",
    "@types/jest": "^29.5.3",
    "@types/supertest": "^2.0.13",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.11.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0"
  }
}
