<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Girişi - Doomsgame.com</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        body { display: flex; justify-content: center; align-items: center; height: 100vh; background-image: radial-gradient(circle at center, rgba(187, 134, 252, 0.1) 0%, transparent 70%); }
        .login-card { background: var(--card-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); padding: 3rem; border-radius: 24px; width: 100%; max-width: 420px; box-shadow: var(--shadow-xl); }
        .form-group { margin-bottom: 1.5rem; }
        label { display: block; margin-bottom: 0.5rem; color: var(--text-dim); font-size: 0.9rem; }
        input { width: 100%; padding: 0.85rem 1.25rem; border-radius: 12px; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.05); color: white; transition: 0.3s; }
        input:focus { border-color: var(--accent-primary); outline: none; background: rgba(255,255,255,0.08); }
        button { width: 100%; padding: 1rem; border: none; border-radius: 12px; background: var(--accent-gradient); color: #000; font-weight: 800; cursor: pointer; transition: 0.3s; text-transform: uppercase; letter-spacing: 1px; }
        button:hover { transform: translateY(-2px); opacity: 0.9; }
        .error { color: #ff5252; background: rgba(255, 82, 82, 0.1); padding: 0.75rem; border-radius: 8px; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="login-card">
        <h1 style="text-align: center; margin-bottom: 2rem; font-weight: 800; color: var(--accent-primary);">Giriş Yap</h1>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label for="username">Kullanıcı Adı</label>
                <input type="text" id="username" name="username" required placeholder="admin">
            </div>
            <div class="form-group">
                <label for="password">Şifre</label>
                <input type="password" id="password" name="password" required placeholder="••••••••">
            </div>
            <button type="submit">Sisteme Gir</button>
        </form>
        <div style="text-align: center; margin-top: 2rem;">
            <a href="/" style="color: var(--text-dim); text-decoration: none; font-size: 0.85rem;">← Anasayfaya Dön</a>
        </div>
    </div>
</body>
</html>
