<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doomsgame - <%= t('hero.title') %></title>
    <meta name="description" content="Doomsgame - <%= t('hero.subtitle') %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Doomsgame - <%= t('hero.title') %>">
    <meta property="og:description" content="<%= t('hero.subtitle') %>">
    <meta property="og:url" content="<%= siteUrl %>/">
    <link rel="canonical" href="<%= siteUrl %>/">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('partials/header') %>

    <div class="container">
        <section class="hero-banner">
            <h1 class="hero-title"><%= t('hero.title') %></h1>
            <p class="hero-subtitle"><%= t('hero.subtitle') %></p>
            <div class="hero-actions">
                <a href="/news" class="btn-primary"><%= t('menu.news') %></a>
                <a href="/#games" class="btn-outline"><%= t('menu.games') %></a>
            </div>
        </section>

        <section id="games">
            <h2 class="section-title"><%= t('menu.games') %></h2>
            <div class="game-grid">
                <% if (games.length > 0) { %>
                    <% games.forEach(game => { %>
                        <div class="game-card">
                            <span class="game-icon">🎮</span>
                            <% if (game.category) { %>
                                <div class="badge-category"><%= game.category %></div>
                            <% } %>
                            <div class="game-title"><%= game.title %></div>
                            <a href="/game/<%= game.id %>" class="btn-play"><%= t('common.play_now') %></a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p><%= t('common.no_games') %></p>
                <% } %>
            </div>
        </section>

        <section class="posts-section">
            <h2 class="section-title"><%= t('menu.news') %></h2>
            <div class="news-grid">
                <% if (posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <a href="/news/<%= post.id %>" class="news-card">
                            <% if (post.category) { %>
                                <div class="badge-category" style="margin-bottom: 1rem;"><%= post.category %></div>
                            <% } %>
                            <span class="news-meta"><%= new Date(post.created_at).toLocaleDateString() %></span>
                            <h3 class="news-title"><%= post.title %></h3>
                            <span class="news-link"><%= t('common.read_more') %> →</span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <p><%= t('common.no_news') %></p>
                <% } %>
            </div>
        </section>
    </div>

    <%- include('partials/footer') %>
</body>
</html>