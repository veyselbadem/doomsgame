<%- include('partials/header') %>

    <div class="container">
        <section class="hero-banner">
            <h1 class="hero-title"><%= t('hero.title') %></h1>
            <p class="hero-subtitle"><%= t('hero.subtitle') %></p>
            <div class="hero-actions">
                <a href="/news" class="btn-primary"><%= t('menu.news') %></a>
                <a href="/#games" class="btn-outline"><%= t('menu.games') %></a>
            </div>
        </section>

        <section id="games">
            <h2 class="section-title"><%= t('menu.games') %></h2>
            <div class="game-grid">
                <% if (games.length > 0) { %>
                    <% games.forEach(game => { %>
                        <div class="game-card">
                            <div class="game-thumb" style="height: 180px; overflow: hidden; background: #000;">
                                <img src="/uploads/games/<%= game.image_path %>" 
                                     alt="<%= game.title %>" 
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.src='/img/default-game.jpg'">
                            </div>
                            <% if (game.category) { %>
                                <div class="badge-category" style="position: absolute; top: 1rem; left: 1rem;"><%= game.category %></div>
                            <% } %>
                            <div class="game-title" style="padding: 1.5rem 1.5rem 0.5rem;"><%= game.title %></div>
                            <div style="padding: 0 1.5rem 1.5rem;">
                                <a href="/game/<%= game.id %>" class="btn-play"><%= t('common.play_now') %></a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p><%= t('common.no_games') %></p>
                <% } %>
            </div>
        </section>

        <section class="posts-section">
            <h2 class="section-title"><%= t('menu.news') %></h2>
            <div class="news-grid">
                <% if (posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <a href="/news/<%= post.id %>" class="news-card">
                            <div style="height: 200px; overflow: hidden; border-radius: 12px; margin-bottom: 1.5rem; background: #1a1a1a;">
                                <img src="/uploads/posts/<%= post.image_path %>" 
                                     alt="<%= post.title %>" 
                                     style="width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.src='/img/default-news.jpg'">
                            </div>
                            <% if (post.category) { %>
                                <div class="badge-category" style="margin-bottom: 1rem;"><%= post.category %></div>
                            <% } %>
                            <span class="news-meta"><%= new Date(post.created_at).toLocaleDateString() %></span>
                            <h3 class="news-title"><%= post.title %></h3>
                            <span class="news-link"><%= t('common.read_more') %> →</span>
                        </a>
                    <% }) %>
                <% } else { %>
                    <p><%= t('common.no_news') %></p>
                <% } %>
            </div>
        </section>
    </div>

<%- include('partials/footer') %>
</body>
</html>