<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.title %> - Doomsgame Oyna</title>
    <meta name="description" content="<%= game.title %> oyunu Doomsgame üzerinde ücretsiz ve kesintisiz oyna.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= game.title %> - Doomsgame Oyna">
    <meta property="og:description" content="<%= game.title %> oyunu Doomsgame üzerinde ücretsiz ve kesintisiz oyna.">
    <meta property="og:url" content="<%= siteUrl %>/game/<%= game.id %>">
    <link rel="canonical" href="<%= siteUrl %>/game/<%= game.id %>">
    <meta name="keywords" content="<%= game.title %>, oyna, ücretsiz oyun, <%= game.title %> embed">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050505;
            --accent-purple: #bb86fc;
            --accent-cyan: #03dac6;
            --text-main: #ffffff;
            --text-dim: #b0b0b0;
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg-color);
            color: var(--text-main);
            margin: 0;
        }

        header {
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(0, 0, 0, 0.8);
            border-bottom: 1px solid var(--glass-border);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 800;
            text-decoration: none;
            color: var(--accent-purple);
        }

        .search-form {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: 2rem;
        }

        .search-input {
            min-width: 220px;
            padding: 0.75rem 1rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.08);
            color: var(--text-main);
            outline: none;
        }

        .search-input::placeholder {
            color: rgba(255,255,255,0.6);
        }

        .search-button {
            padding: 0.85rem 1.2rem;
            border: none;
            border-radius: 999px;
            background: var(--accent-purple);
            color: #000;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .search-button:hover {
            transform: translateY(-1px);
            opacity: 0.95;
        }

        .game-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 5%;
        }

        .embed-wrapper {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            border-radius: 12px;
            border: 2px solid var(--accent-cyan);
            overflow: hidden;
            box-shadow: 0 0 50px rgba(3, 218, 198, 0.2);
        }

        .embed-wrapper iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .game-details {
            margin-top: 3rem;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 3rem;
        }

        .details-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            padding: 2rem;
            border-radius: 12px;
        }

        h1,
        h2 {
            color: var(--accent-purple);
        }

        .ai-insight {
            border-left: 4px solid var(--accent-cyan);
            padding-left: 1.5rem;
            font-style: italic;
            color: var(--text-dim);
        }

        footer {
            text-align: center;
            padding: 2rem;
            color: var(--text-dim);
            margin-top: 4rem;
        }
    </style>
</head>

<body>
    <header>
        <a href="/" class="logo">Doomsgame</a>
        <nav>
            <a href="/" style="color: white; text-decoration: none;">
                <%= t('menu.home') %>
            </a>
            <form action="/search" method="get" class="search-form">
                <input name="q" type="search" class="search-input" placeholder="<%= t('common.search_placeholder') %>" aria-label="<%= t('common.search_placeholder') %>">
                <button type="submit" class="search-button"><%= t('menu.search') %></button>
            </form>
        </nav>
    </header>

    <div class="game-container">
        <h1>
            <%= game.title %>
        </h1>
        <div class="embed-wrapper">
            <%- game.embed_code %>
        </div>

        <div class="game-details">
            <div class="details-card">
                <h2>
                    <%= t('game_page.description') %>
                </h2>
                <p>
                    <%= game.title %> oyununu şimdi tarayıcınız üzerinden ücretsiz oynayın!
                </p>
            </div>
            <div class="details-card">
                <h2>
                    <%= t('game_page.ai_insight') %>
                </h2>
                <div class="ai-insight">
                    "Bu oyun, türünün en iyi örneklerinden biri olarak kabul edilir ve akıcı mekanikleriyle sizi
                    saatlerce ekrana bağlayabilir."
                </div>
            </div>
        </div>
    </div>

    <footer>
        &copy; 2026 Doomsgame
    </footer>
</body>

</html>