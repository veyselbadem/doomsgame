<%- include('partials/header') %>

    <style>
        .game-view-container { max-width: 1200px; margin: 2rem auto; padding: 0 5%; }
        .embed-wrapper { 
            position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; 
            border-radius: 20px; border: 1px solid var(--accent-secondary); overflow: hidden; 
            box-shadow: 0 0 50px rgba(3, 218, 198, 0.15); 
        }
        .embed-wrapper iframe { width: 100%; height: 100%; border: none; }
        .game-info-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-top: 3rem; }
        .info-card { background: var(--card-bg); border: 1px solid var(--glass-border); padding: 2rem; border-radius: 20px; }
        .ai-note { border-left: 4px solid var(--accent-secondary); padding-left: 1.5rem; font-style: italic; color: var(--text-dim); }
        @media (max-width: 768px) { .game-info-grid { grid-template-columns: 1fr; } }
    </style>

    <div class="game-view-container">
        <h1 class="hero-title" style="text-align: left; font-size: 2.5rem; margin-bottom: 2rem;"><%= game.title %></h1>
        
        <% if (game.category) { %>
            <div class="badge-category" style="margin-bottom: 1.5rem;"><%= game.category %></div>
        <% } %>

        <div class="embed-wrapper">
            <%- game.embed_code %>
        </div>

        <div class="game-info-grid">
            <div class="info-card">
                <h2 style="margin-bottom: 1rem;"><%= t('game_page.description') %></h2>
                <p><%= game.title %> oyununu şimdi tarayıcınız üzerinden ücretsiz ve hızlıca oynayın. Doomsgame otonom editörleri tarafından sizin için seçildi.</p>
            </div>
            <div class="info-card">
                <h2 style="margin-bottom: 1rem; color: var(--accent-primary);"><%= t('game_page.ai_insight') %></h2>
                <div class="ai-note">
                    "Bu oyun, yüksek kalite puanı ve akıcı oyun yapısı nedeniyle kütüphanemize dahil edilmiştir."
                </div>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>
</body>
</html>