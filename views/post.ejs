<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - Doomsgame</title>
    <meta name="description" content="<%= post.title %> Doomsgame haber sayfasında.">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= post.title %> - Doomsgame">
    <meta property="og:description" content="<%= post.title %> Doomsgame haber sayfasında.">
    <meta property="og:url" content="<%= siteUrl %>/news/<%= post.id %>">
    <link rel="canonical" href="<%= siteUrl %>/news/<%= post.id %>">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050505;
            --card-bg: rgba(255, 255, 255, 0.05);
            --accent-purple: #bb86fc;
            --accent-cyan: #03dac6;
            --text-main: #ffffff;
            --text-dim: #b0b0b0;
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            margin: 0;
            font-family: 'Outfit', sans-serif;
            background: var(--bg-color);
            color: var(--text-main);
        }

        header {
            padding: 1.5rem 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(0, 0, 0, 0.8);
            border-bottom: 1px solid var(--glass-border);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-purple);
            text-decoration: none;
        }

        .search-form {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .search-input {
            min-width: 240px;
            padding: 0.75rem 1rem;
            border-radius: 999px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.08);
            color: var(--text-main);
            outline: none;
        }

        .search-button {
            padding: 0.85rem 1.2rem;
            border: none;
            border-radius: 999px;
            background: var(--accent-purple);
            color: #000;
            font-weight: 700;
            cursor: pointer;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 3rem 5%;
        }

        .post-meta {
            color: var(--accent-cyan);
            font-weight: 600;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        h1 {
            font-size: clamp(2.3rem, 4vw, 3.5rem);
            margin-bottom: 1rem;
        }

        .content {
            line-height: 1.85;
            color: var(--text-dim);
        }

        .back-link {
            display: inline-flex;
            margin-top: 2rem;
            color: var(--accent-cyan);
            text-decoration: none;
            font-weight: 700;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        footer {
            text-align: center;
            padding: 3rem 5%;
            border-top: 1px solid var(--glass-border);
            color: var(--text-dim);
        }
    </style>
</head>

<body>
    <header>
        <a href="/" class="logo">Doomsgame</a>
        <form action="/search" method="get" class="search-form">
            <input name="q" type="search" class="search-input" placeholder="<%= t('common.search_placeholder') %>" aria-label="<%= t('common.search_placeholder') %>">
            <button type="submit" class="search-button"><%= t('menu.search') %></button>
        </form>
    </header>

    <div class="container">
        <p class="post-meta"><%= t('common.published_at') %> <%= new Date(post.created_at).toLocaleDateString() %></p>
        <h1><%= post.title %></h1>
        <div class="content">
            <%- post.content %>
        </div>
        <a href="/news" class="back-link">← <%= t('menu.news') %></a>
    </div>

    <footer>
        &copy; 2026 Doomsgame
    </footer>
</body>

</html>