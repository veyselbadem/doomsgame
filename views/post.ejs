<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> - Doomsgame</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <style>
        .article-container { max-width: 900px; margin: 4rem auto; padding: 0 5%; }
        .article-meta { color: var(--accent-secondary); font-weight: 600; margin-bottom: 1rem; text-transform: uppercase; font-size: 0.9rem; }
        .article-title { font-size: clamp(2.5rem, 5vw, 4rem); margin-bottom: 2rem; line-height: 1.1; }
        .article-content { font-size: 1.15rem; line-height: 1.9; color: var(--text-dim); }
        .article-content h2, .article-content h3 { color: var(--text-main); margin: 2rem 0 1rem; }
        .article-content p { margin-bottom: 1.5rem; }
        .back-btn { display: inline-flex; margin-top: 3rem; color: var(--accent-secondary); text-decoration: none; font-weight: 700; gap: 0.5rem; transition: 0.3s; }
        .back-btn:hover { transform: translateX(-5px); }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="article-container">
        <article>
            <span class="article-meta"><%= t('common.published_at') %>: <%= new Date(post.created_at).toLocaleDateString() %></span>
            <h1 class="article-title"><%= post.title %></h1>
            <div class="article-content">
                <%- post.content %>
            </div>
            <a href="/news" class="back-btn">← <%= t('menu.news') %></a>
        </article>
    </div>

    <%- include('partials/footer') %>
</body>
</html>